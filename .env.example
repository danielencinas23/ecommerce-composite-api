# Puertos de cada servicio
GATEWAY_PORT=3000
CATALOG_PORT=3001
INVENTORY_PORT=3002

# URLs que usa la Composite API para llegar a los microservicios
CATALOG_URL=http://localhost:3001
INVENTORY_URL=http://localhost:3002

# APIs externas de divisas (principal y respaldo)
FRANKFURTER_URL=https://api.frankfurter.dev/v1
ER_API_URL=https://open.er-api.com/v6

# Tiempo máximo de espera por servicio (ms)
SERVICE_TIMEOUT_MS=3000

# Retardo simulado del inventario para P-104 (ms)
SIMULATED_DELAY_MS=5000
